  huntMapInfoList:
  - mapType: 0
    mapSprite: {fileID: 21300000, guid: 4ae84a77662c7bb4d8229e11a65a98cb, type: 3}
    mapName: "\u65B0\u7586\u5927\u8349\u539F"
    mapDescription: "\u8FD9\u7247\u65B0\u7586\u8349\u539F\u5730\u56FE\u8FBD\u9614\u58EE\u7F8E\uFF0C\u78A7\u7EFF\u8349\u7538\u5982\u6CE2\u6D6A\u822C\u5EF6\u4F38\u81F3\u5929\u9645\u7EBF\uFF0C\u4E0E\u8FDC\u5904\u5DCD\u5CE8\u7684\u96EA\u5C71\u76F8\u6620\u6210\u8DA3\u3002\u70B9\u7F00\u5176\u95F4\u7684\u767D\u8272\u6BE1\u623F\u3001\u60A0\u95F2\u725B\u7F8A\u7FA4\u4E0E\u4F4E\u5782\u7684\u4E91\u6735\uFF0C\u5171\u540C\u6784\u6210\u4E86\u5B81\u9759\u800C\u5145\u6EE1\u751F\u673A\u7684\u585E\u5916\u98CE\u5149\uFF0C\u4EE4\u4EBA\u5FC3\u65F7\u795E\u6021\u3002"
  - mapType: 1
    mapSprite: {fileID: 21300000, guid: a6296feaa12658b44b8ee00ff850d766, type: 3}
    mapName: "\u7687\u5BB6\u68EE\u6797\u730E\u573A"
    mapDescription: "\u8FD9\u5EA7\u7687\u5BB6\u730E\u573A\u53E4\u6811\u53C2\u5929\uFF0C\u6797\u836B\u9053\u4E0E\u53E4\u8001\u77F3\u96D5\u4EA4\u9519\u3002\u9633\u5149\u900F\u8FC7\u7E41\u8302\u679D\u53F6\uFF0C\u5728\u5E03\u6EE1\u843D\u53F6\u7684\u5C0F\u5F84\u6295\u4E0B\u6591\u9A73\u5149\u5F71\u3002\u6797\u95F4\u65F6\u6709\u91CE\u517D\u8E2A\u8FF9\u4E0E\u730E\u54E8\uFF0C\u4E8E\u9759\u8C27\u4E2D\u5F25\u6F2B\u7740\u8083\u7A46\u800C\u91CE\u6027\u7684\u72E9\u730E\u6C14\u606F\u3002"
  - mapType: 2
    mapSprite: {fileID: 21300000, guid: 1422662ae15f5314d8d9b29b16a41b9c, type: 3}
    mapName: "\u6D77\u6EE8\u6C99\u6EE9"
    mapDescription: "\u6D77\u6EE8\u6C99\u6EE9\u5730\u56FE\u4EE5\u851A\u84DD\u6D77\u6D6A\u4E0E\u67D4\u8F6F\u767D\u6C99\u6EE9\u6784\u6210\u4E3B\u57FA\u8C03\uFF0C\u659C\u501A\u7684\u6930\u5B50\u6811\u6295\u4E0B\u6591\u9A73\u9634\u5F71\uFF0C\u8FDC\u5904\u70B9\u7F00\u7740\u8272\u5F69\u660E\u5FEB\u7684\u906E\u9633\u4F1E\u4E0E\u6C99\u6EE9\u6392\u7403\u7F51\u3002\u6F6E\u6C50\u58F0\u4F34\u7740\u9690\u7EA6\u6D77\u9E25\u9E23\u53EB\uFF0C\u8425\u9020\u51FA\u60A0\u95F2\u800C\u53C8\u5145\u6EE1\u6D3B\u529B\u7684\u5EA6\u5047\u6C1B\u56F4\uFF0C\u662F\u7EDD\u4F73\u7684\u72E9\u730E\u4E4B\u5730\u3002"
  - mapType: 3
    mapSprite: {fileID: 21300000, guid: 7ffce37df22838e49b444b29043230a9, type: 3}
    mapName: "\u79C1\u4EBA\u82B1\u56ED"
    mapDescription: "\u8FD9\u5EA7\u9690\u853D\u7684\u79C1\u4EBA\u82B1\u56ED\u7EFF\u610F\u76CE\u7136\uFF0C\u873F\u8712\u7684\u77F3\u5F84\u7A7F\u8FC7\u7E41\u8302\u82B1\u4E1B\uFF0C\u901A\u5411\u7CBE\u81F4\u7684\u5EAD\u9662\u3002\u7075\u52A8\u7684\u8424\u706B\u866B\u4E0E\u53E4\u6734\u77F3\u96D5\u70B9\u7F00\u5176\u95F4\uFF0C\u9759\u8C27\u4E2D\u53EA\u95FB\u6D41\u6C34\u4E0E\u9E1F\u9E23\uFF0C\u8425\u9020\u51FA\u4E00\u65B9\u5B81\u9759\u800C\u53C8\u5145\u6EE1\u63A2\u7D22\u4E50\u8DA3\u7684\u79C1\u5BC6\u5929\u5730\u3002"
