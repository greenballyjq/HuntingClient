      \u201C\u4E11\u4E2B\u5934\u201D\u06C7\u06AD \u7684\u8138\u3002\u5979\u662F\u5BB6\u4E2D\u7684\u7B2C\u4E09\u4E2A\u5973\u513F\uFF0C\u7236\u6BCD\u4E3A\u4E86\u751F\u8BA1\u5916\u51FA\u52A1\u5DE5\uFF0C\u5C06\u5979\u5BC4\u517B\u5728\u8FDC\u65B9\u4EB2\u621A\u5BB6\uFF0C\u8FD9\u4E00\u5BC4\u517B\uFF0C\u4FBF\u662F\u6574\u4E2A\u7AE5\u5E74\u3002\r\n\u4EB2\u621A\u5BB6\u7684\u5B69\u5B50\u7A7F\u7740\u5D2D\u65B0\u7684\u8863\u88F3\uFF0C\u9022\u5E74\u8FC7\u8282\u8FD8\u6709\u6F02\u4EAE\u7684\u53D1\u9970\uFF0C\u800C\u5927\u7F8E\u4E3D\uFF0C\u603B\u662F\u6361\u7740\u65E7\u8863\u7A7F\uFF0C\u5934\u53D1\u4E5F\u5E38\u5E38\u662F\u4E71\u84EC\u84EC\u7684\u3002\u4EB2\u621A\u4EEC\u6BEB\u4E0D\u907F\u8BB3\u5730\u5728\u5979\u9762\u524D\u8C08\u8BBA\uFF1A\u201C\u8FD9\u5B69\u5B50\uFF0C\u957F\u5F97\u968F\u8C01\u5462\uFF1F\u4E00\u70B9\u90FD\u4E0D\u62DB\u4EBA\u559C\u6B22\u3002\u201D
      \u90A3\u4E9B\u8BDD\u8BED\u50CF\u4E00\u6839\u6839\u5C16\u9510\u7684\u523A\uFF0C\u624E\u8FDB\u5979\u5E7C\u5C0F\u7684\u5FC3\u7075\u3002\u6BCF\u6B21\u5B66\u6821\u91CC\u6709\u6D3B\u52A8\uFF0C\u5979\u90FD\u53EA\u80FD\u8EB2\u5728\u89D2\u843D\u91CC\uFF0C\u770B\u7740\u5176\u4ED6\u5B69\u5B50\u5149\u9C9C\u4EAE\u4E3D\u5730\u7AD9\u5728\u821E\u53F0\u4E2D\u592E\uFF0C\u5979\u5BF9\u7F8E\u7684\u6E34\u671B\u5728\u90A3\u4E00\u523B\u88AB\u65E0\u9650\u653E\u5927\uFF0C\u5374\u53C8\u53EA\u80FD\u65E0\u5948\u5730\u538B\u6291\u5728\u5FC3\u5E95\u590F\u7D2B\u5FAE\uFF0C\u751F\u4E8E\u8BD7\u753B\u6D78\u6DA6\u7684\u53F0\u6E7E\u963F\u91CC\u5C71\u811A\u4E0B\u6E56\u7554\uFF0C\u4F4F\u7740\u4E00\u4F4D\u540D\u53EB\u7D2B\u5FAE\u7684\u5973\u5B69\u3002\u5979\u81EA\u5E7C\u4FBF\u751F\u5F97\u6781\u4E3A\u6F02\u4EAE\uFF0C\u90A3\u4E00\u53CC\u6C34\u6C6A\u6C6A\u7684\u5927\u773C\u775B\uFF0C\u4EFF\u4F5B\u85CF\u7740\u661F\u8FB0\u5927\u6D77\uFF0C\u7B11\u8D77\u6765\u8FD8\u6709\u4E24\u4E2A\u6D45\u6D45\u7684\u9152\u7A9D\uFF0C\u751C\u5F97\u80FD\u628A\u4EBA\u7684\u5FC3\u90FD\u878D\u5316\u6389\u3002\u5979\u7684\u7F8E\u4E3D\u5982\u540C\u7737\u6751\u5DF7\u5B50\u91CC\u76DB\u5F00\u5F97\u6700\u7EDA\u70C2\u7684\u82B1\u6735\uFF0C\u6210\u4E3A\u90BB\u91CC\u95F4\u5938\u8D5E\u7684\u5BF9\u8C61\u5C0F\u65F6\u5019\u7684\u4E9A\u514B\u4E1C\u662F\u5728\u7F8A\u7FA4\u4E2D\u957F\u5927\u7684\uFF0C\u4ED6\u6CA1\u7ECF\u8FC7\u4EC0\u4E48\u6559\u80B2\uFF0C\u53EA\u662F\u4F1A\u5199\u81EA\u5DF1\u7684\u7EF4\u543E\u5C14\u540D\u5B57\u06C7\u06AD
      \uFF0C\u8BFB\u4F5C\u897F\u65E5\u963F\u6D2A\uFF0C\u610F\u601D\u662F\u72EE\u5B50\uFF0C\u4ED6\u7684\u7236\u4EB2\u5E0C\u671B\u4ED6\u50CF\u72EE\u5B50\u4E00\u6837\u52C7\u731B\u91D1\u72B6\u5143\uFF0C\u4E00\u4F4D\u5E74\u7EA6\u56DB\u5341\u3001\u98CE\u5EA6\u7FE9\u7FE9\u7684\u4E2D\u5E74\u5E05\u54E5\uFF0C\u4EE5\u5176\u72EC\u7279\u7684\u9B45\u529B\u548C\u4E0D\u51E1\u7684\u6C14\u8D28\uFF0C\u5728\u865A\u62DF\u4E16\u754C\u4E2D\u72EC\u6811\u4E00\u5E1C\u3002\u4ED6\u7684\u540D\u5B57\uFF0C\u4E0D\u4EC5\u662F\u5BF9\u53E4\u4EE3\u79D1\u4E3E\u5236\u5EA6\u4E0B\u6700\u9AD8\u8363\u8A89\u7684\u81F4\u656C\uFF0C\u66F4\u662F\u4ED6\u4E2A\u4EBA\u9B45\u529B\u4E0E\u667A\u6167\u5E76\u91CD\u7684\u8C61\u5F81\u3002\u91D1\u72B6\u5143\u62E5\u6709\u4E00\u5934\u7CBE\u5FC3\u6253\u7406\u7684\u4E09\u4E03\u5F00\u5934\u53D1\uFF0C\u6BCF\u5F53\u4ED6\u8F7B\u8F7B\u64A9\u8D77\u90A3\u4FA7\u5206\u7684\u5218\u6D77\uFF0C\u603B\u80FD\u4E0D\u7ECF\u610F\u95F4\u6563\u53D1\u51FA\u6210\u719F\u7537\u6027\u7684\u7A33\u91CD\u4E0E\u81EA\u4FE1\uFF0C\u8FD9\u4E00\u52A8\u4F5C\uFF0C\u65E9\u5DF2\u6210\u4E3A\u4ED6\u6807\u5FD7\u6027\u7684\u98CE\u91C7\u5C55\u73B0\uFF0C\u6DF1\u53D7\u4E2D\u8001\u5E74\u5987\u5973\u7684\u559C\u7231\u4E0E\u8FFD\u6367\u3002\u7531\u7B80\u6D01\u5229\u843D\u7684\u8272\u5757\u62FC\u63A5\u800C\u6210\uFF0C\u52FE\u52D2\u51FA\u57FA\u7840\u4EBA\u5F62\u8F6E\u5ED3\u3002\u4ED6\u6CA1\u6709\u7E41\u590D\u7684\u7EC6\u8282\uFF0C\u5374\u62E5\u6709\u6781\u9AD8\u7684\u8FA8\u8BC6\u5EA6\u4E0E\u7075\u6D3B\u6027\u3002\u9C9C\u660E\u7684\u5355\u8272\u4E3B\u4F53\u4F7F\u5176\u5728\u573A\u666F\u4E2D\u683C\u5916\u9192\u76EE\uFF0C\u662F\u4E3A\u6240\u6709\u73A9\u5BB6\u8BBE\u8BA1\u7684\uFF0C\u6613\u4E8E\u4E0A\u624B\u4E14\u5145\u6EE1\u65E0\u9650\u53EF\u80FD\u7684\u7A7A\u767D\u753B\u5E03\u8FD9\u7247\u65B0\u7586\u8349\u539F\u5730\u56FE\u8FBD\u9614\u58EE\u7F8E\uFF0C\u78A7\u7EFF\u8349\u7538\u5982\u6CE2\u6D6A\u822C\u5EF6\u4F38\u81F3\u5929\u9645\u7EBF\uFF0C\u4E0E\u8FDC\u5904\u5DCD\u5CE8\u7684\u96EA\u5C71\u76F8\u6620\u6210\u8DA3\u3002\u70B9\u7F00\u